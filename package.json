{
  "name": "zustrolabs-web",
  "private": true,
  "description": "Landing de Zustro Labs (zustrolabs.com). Sitio estático, sin build.",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "versionar": "node scripts/versionar.mjs",
    "test": "playwright test",
    "test:worker": "node --test 'worker/test/*.test.js'",
    "lint:html": "html-validate 'site/**/*.html'",
    "test:links": "playwright test --grep @red",
    "check": "npm run test:worker && npm run lint:html && playwright test --grep-invert @red"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.56.1",
    "html-validate": "11.16.0"
  }
}
